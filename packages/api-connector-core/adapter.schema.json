{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 512
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029<>\\u0060\"]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z.+-]{1,32}$"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "baseUrl": {
      "type": "string",
      "maxLength": 2048
    },
    "redirectHosts": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 253,
        "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
      }
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "apiKey"
            },
            "in": {
              "type": "string",
              "enum": ["header", "query"]
            },
            "name": {
              "type": "string"
            }
          },
          "required": ["type", "in", "name"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bearer"
            }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "basic"
            }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "oauth2ClientCredentials"
            },
            "tokenUrl": {
              "type": "string",
              "maxLength": 2048
            },
            "tokenHost": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
            },
            "scope": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": ["type", "tokenUrl"],
          "additionalProperties": false
        }
      ]
    },
    "headers": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "operations": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "kind": {
            "type": "string",
            "enum": ["read", "write"]
          },
          "method": {
            "type": "string",
            "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
          },
          "readOnlyPost": {
            "type": "boolean"
          },
          "path": {
            "type": "string",
            "maxLength": 1024
          },
          "params": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "object"
              },
              "description": {
                "type": "string",
                "maxLength": 500
              },
              "properties": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "string"
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 500
                        },
                        "enum": {
                          "minItems": 1,
                          "maxItems": 100,
                          "type": "array",
                          "items": {
                            "anyOf": [
                              {
                                "type": "string",
                                "maxLength": 200
                              },
                              {
                                "type": "number"
                              }
                            ]
                          }
                        },
                        "format": {
                          "type": "string",
                          "enum": ["date", "date-time", "email", "uri", "uuid"]
                        },
                        "minLength": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "maxLength": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10000
                        }
                      },
                      "required": ["type"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "number"
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 500
                        },
                        "enum": {
                          "minItems": 1,
                          "maxItems": 100,
                          "type": "array",
                          "items": {
                            "anyOf": [
                              {
                                "type": "string",
                                "maxLength": 200
                              },
                              {
                                "type": "number"
                              }
                            ]
                          }
                        },
                        "minimum": {
                          "type": "number"
                        },
                        "maximum": {
                          "type": "number"
                        }
                      },
                      "required": ["type"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "integer"
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 500
                        },
                        "enum": {
                          "minItems": 1,
                          "maxItems": 100,
                          "type": "array",
                          "items": {
                            "anyOf": [
                              {
                                "type": "string",
                                "maxLength": 200
                              },
                              {
                                "type": "number"
                              }
                            ]
                          }
                        },
                        "minimum": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "maximum": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["type"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "boolean"
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 500
                        }
                      },
                      "required": ["type"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "array"
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 500
                        },
                        "items": {
                          "oneOf": [
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "string"
                                },
                                "description": {
                                  "type": "string",
                                  "maxLength": 500
                                },
                                "enum": {
                                  "minItems": 1,
                                  "maxItems": 100,
                                  "type": "array",
                                  "items": {
                                    "anyOf": [
                                      {
                                        "type": "string",
                                        "maxLength": 200
                                      },
                                      {
                                        "type": "number"
                                      }
                                    ]
                                  }
                                },
                                "format": {
                                  "type": "string",
                                  "enum": ["date", "date-time", "email", "uri", "uuid"]
                                },
                                "minLength": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 9007199254740991
                                },
                                "maxLength": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 10000
                                }
                              },
                              "required": ["type"],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "number"
                                },
                                "description": {
                                  "type": "string",
                                  "maxLength": 500
                                },
                                "enum": {
                                  "minItems": 1,
                                  "maxItems": 100,
                                  "type": "array",
                                  "items": {
                                    "anyOf": [
                                      {
                                        "type": "string",
                                        "maxLength": 200
                                      },
                                      {
                                        "type": "number"
                                      }
                                    ]
                                  }
                                },
                                "minimum": {
                                  "type": "number"
                                },
                                "maximum": {
                                  "type": "number"
                                }
                              },
                              "required": ["type"],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "integer"
                                },
                                "description": {
                                  "type": "string",
                                  "maxLength": 500
                                },
                                "enum": {
                                  "minItems": 1,
                                  "maxItems": 100,
                                  "type": "array",
                                  "items": {
                                    "anyOf": [
                                      {
                                        "type": "string",
                                        "maxLength": 200
                                      },
                                      {
                                        "type": "number"
                                      }
                                    ]
                                  }
                                },
                                "minimum": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                },
                                "maximum": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                }
                              },
                              "required": ["type"],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "boolean"
                                },
                                "description": {
                                  "type": "string",
                                  "maxLength": 500
                                }
                              },
                              "required": ["type"],
                              "additionalProperties": false
                            }
                          ]
                        },
                        "maxItems": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        }
                      },
                      "required": ["type", "items"],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "additionalProperties": {
                "type": "boolean",
                "const": false
              }
            },
            "required": ["type"],
            "additionalProperties": false
          },
          "query": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.\\-[\\]]{1,128}$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "body": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 128
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "items": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^(\\/([^~/]|~[01])*)*$"
          },
          "fields": {
            "anyOf": [
              {
                "minItems": 1,
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 512
                }
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "maxLength": 512
                },
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 512
                }
              }
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "customer.lookup",
              "customer.summary",
              "customer.orders",
              "customer.invoices",
              "deal.list",
              "stock.check"
            ]
          },
          "pagination": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "cursor"
                  },
                  "param": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-[\\]]{1,128}$"
                  },
                  "cursorPointer": {
                    "type": "string",
                    "maxLength": 512,
                    "pattern": "^(\\/([^~/]|~[01])*)*$"
                  },
                  "maxPages": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  }
                },
                "required": ["type", "param", "cursorPointer"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "page"
                  },
                  "param": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-[\\]]{1,128}$"
                  },
                  "sizeParam": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-[\\]]{1,128}$"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200
                  },
                  "maxPages": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  }
                },
                "required": ["type", "param", "size"],
                "additionalProperties": false
              }
            ]
          },
          "chain": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "params": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 2000
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              },
              "required": ["operation", "params"],
              "additionalProperties": false
            }
          }
        },
        "required": ["name", "description", "kind", "method", "path", "params", "fields"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "name", "version", "baseUrl", "auth", "operations"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "title": "Liaison API connector adapter"
}
