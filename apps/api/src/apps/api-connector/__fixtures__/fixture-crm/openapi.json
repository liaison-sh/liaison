    "/contacts": {
      "post": {
        "operationId": "createContact",
        "summary": "Create a contact at an existing company or at a new one",
        "description": "Give exactly one of contact.company_id (an existing company) and contact.company (a new company created in the same call; the response then carries it). Refused with 409 when the email or the new company's domain already exists.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewContact"
              }
