=== thread-header ===
<div class="flex shrink-0 items-center justify-between border-b border-border-subtle px-4 py-2.5">
  <div class="flex min-w-0 items-center gap-3">
    <div class="relative shrink-0" role="group" data-testid="avatar-stack" aria-label="2 participants">
      <div class="absolute inset-0">
        <div>
          <div class="flex items-center justify-center rounded-full font-semibold"> "CR"
        <div>
          <div class="flex items-center justify-center rounded-full font-semibold"> "ME"
      <div class="flex items-center absolute left-0 top-0" data-testid="avatar-stack-expanded">
        <span class="inline-flex" type="button">
          <div class="relative shrink-0 cursor-default">
            <div class="flex items-center justify-center rounded-full font-semibold"> "CR"
        <span class="inline-flex" type="button">
          <div class="relative shrink-0 cursor-default">
            <div class="flex items-center justify-center rounded-full font-semibold"> "ME"
    <div class="min-w-0" data-testid="thread-header-title-block">
      <div class="flex items-center gap-1.5">
        <h2 class="truncate text-[14px] font-semibold text-text" data-testid="thread-header-title"> "Baseline thread"
      <div class="flex items-center gap-1.5 text-[11.5px] text-text-tertiary">
        <svg class="lucide lucide-users lucide-icon" aria-hidden="true">
          <path>
          <path>
          <path>
          <circle>
        <span data-testid="participant-count"> "2"
        <button class="outline-none ml-1 flex h-4.5 w-4.5 items-center justify-center rounded text-text-tertiary transition-colors hover:bg-surface-hover hover:text-text-secondary" type="button" aria-label="Add participant">
          <svg class="lucide lucide-plus lucide-icon" aria-hidden="true">
            <path>
            <path>
  <div class="flex items-center gap-2">
    <div class="relative flex">
      <button class="outline-none flex h-7 w-7 items-center justify-center rounded-md text-text-tertiary transition-colors hover:bg-surface-hover hover:text-text-secondary" type="button" data-testid="thread-header.actions" aria-label="Thread actions">
        <svg class="lucide lucide-ellipsis lucide-more-horizontal lucide-icon" aria-hidden="true">
          <circle>
          <circle>
          <circle>

=== thread-composer ===
<div class="relative px-4 pb-[max(0.875rem,var(--shell-dock-clearance,0px))] pt-1" data-testid="compose-dropzone">
  <div class="flex flex-col overflow-hidden rounded-[18px] bg-elevated ring-1 ring-border-strong transition-[box-shadow] focus-within:shadow-composer-focus focus-within:ring-1 focus-within:ring-accent/40">
    <div class="flex flex-col">
      <div class="contents">
        <div class="px-4 pb-1 pt-3.5">
          <div class="relative w-full min-w-0 [--editor-bg:var(--color-elevated)]" data-testid="compose-field">
            <div class="rich-editor flex min-w-0 flex-col gap-2.5">
              <div class="min-w-0">
                <div class="tiptap ProseMirror prose-thread min-w-0 outline-none max-h-[176px] min-h-[22px] overflow-y-auto text-[15px]! leading-[22px]!" role="textbox" data-testid="compose-editor" aria-label="Write a message" contenteditable="true">
                  <p class="is-empty is-editor-empty">
                    <br class="ProseMirror-trailingBreak">
            <div class="pointer-events-none absolute inset-x-0 bottom-0 select-none truncate text-text-secondary text-[15px] leading-[22px]">
              <span class="sm:hidden"> "Write a message"
              <span class="hidden sm:inline"> "Write a message... (@ people, # threads)"
      <div class="flex items-center gap-0.5 px-2 pb-2 pt-1.5 flex-nowrap" data-testid="compose-controls-row">
        <div class="contents">
          <button class="flex h-[34px] w-[34px] shrink-0 items-center justify-center rounded-[10px] p-0 text-text-secondary transition-colors hover:bg-surface-hover hover:text-text disabled:opacity-40" type="button" data-testid="composer-plus" aria-label="Add attachment" title="Add attachment">
            <svg class="lucide lucide-plus lucide-icon" aria-hidden="true">
              <path>
              <path>
          <button class="flex h-[34px] w-[34px] shrink-0 items-center justify-center rounded-[10px] p-0 text-text-secondary transition-colors hover:bg-surface-hover hover:text-text disabled:opacity-40 aria-pressed:bg-surface-active aria-pressed:text-text" type="button" data-testid="compose-formatting" aria-label="Show formatting" title="Show formatting">
            <svg class="lucide lucide-case-sensitive lucide-icon" aria-hidden="true">
              <path>
              <path>
              <path>
              <circle>
          <button class="disabled:opacity-50 flex h-[34px] w-[34px] shrink-0 items-center justify-center rounded-[10px] p-0 text-text-secondary transition-colors hover:bg-surface-hover hover:text-text" type="button" data-testid="magic-wand" aria-label="Fix spelling & grammar" title="Fix spelling & grammar">
            <svg class="lucide lucide-wand-sparkles lucide-wand-2 lucide-icon" aria-hidden="true">
              <path>
              <path>
              <path>
              <path>
              <path>
              <path>
              <path>
              <path>
          <button class="outline-none disabled:opacity-50 flex h-[34px] w-[34px] shrink-0 items-center justify-center rounded-[10px] p-0 text-text-secondary transition-colors hover:bg-surface-hover hover:text-text" type="button" data-testid="compose-emoji" aria-label="Add emoji">
            <svg class="lucide lucide-face-slightly-smiling lucide-smile lucide-icon" aria-hidden="true">
              <path>
              <path>
              <path>
              <circle>
          <div class="ml-auto flex items-center gap-0.5">
            <button class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-accent text-accent-foreground transition-[background-color,color,transform] hover:bg-accent-hover active:scale-95 disabled:cursor-not-allowed disabled:bg-surface-active disabled:text-text-tertiary disabled:active:scale-100" type="button" data-testid="compose-send" aria-label="Send message" disabled="">
              <svg class="lucide lucide-arrow-up lucide-icon" aria-hidden="true">
                <path>
                <path>
      <div class="hidden" data-testid="compose-hidden-attach">
        <label class="inline-flex cursor-pointer items-center gap-1 rounded-sm border border-border bg-surface px-2 py-1 text-[11px] text-text hover:bg-surface-hover" data-testid="attachment-upload-button" aria-label="Attach" title="Attach">
          <svg class="lucide lucide-paperclip lucide-icon" aria-hidden="true">
            <path>
          <span class="hidden sm:inline"> "Attach"
          <input class="hidden" type="file" data-testid="attachment-upload-input">

=== conversation-tab ===
<div class="relative flex h-full">
  <div class="relative inline-flex h-full shrink-0 items-center px-2.5 py-0 text-[12.5px] font-medium outline-none transition-colors hover:bg-surface-hover focus-visible:bg-surface-hover group/item gap-0 pr-1 pl-0 bg-surface-hover">
    <button class="flex h-full min-w-0 items-center gap-1.5 pl-2 pr-1 outline-none" type="button" data-testid="dock-tab-toggle">
      <span class="relative flex shrink-0 items-center justify-center" data-testid="dock-avatar">
        <span class="flex h-full w-full items-center justify-center rounded-full bg-surface-hover text-text-secondary">
          <svg class="lucide lucide-lock lucide-icon" aria-hidden="true">
            <rect>
            <path>
      <span class="truncate text-text-secondary text-text" data-testid="dock-tab-name"> "Baseline thread"
    <button class="flex h-[22px] w-[22px] shrink-0 items-center justify-center rounded-[4px] text-text-tertiary outline-none transition-opacity hover:bg-surface-active hover:text-text focus-visible:opacity-100 opacity-100" type="button" data-testid="dock-tab-close" aria-label="Close Baseline thread" title="Close">
      <svg class="lucide lucide-x lucide-icon" aria-hidden="true">
        <path>
        <path>
    <span class="pointer-events-none absolute right-2 bottom-0 left-2 h-0.5 rounded-full bg-accent" data-testid="dock-tab-active-line" aria-hidden="true">
  <div class="absolute flex flex-col overflow-hidden rounded-t-[10px] border border-b-0 border-border-strong bg-elevated shadow-dock-window" data-testid="dock-window">
    <div class="flex shrink-0 items-center justify-between gap-2 border-b border-border-subtle px-3 py-2" data-testid="dock-window-header">
      <div class="flex min-w-0 items-center gap-2.5">
        <span class="relative flex shrink-0 items-center justify-center" data-testid="dock-avatar">
          <span class="flex h-full w-full items-center justify-center rounded-full bg-surface-hover text-text-secondary">
            <svg class="lucide lucide-lock lucide-icon" aria-hidden="true">
              <rect>
              <path>
        <div class="flex min-w-0 flex-col">
          <span class="truncate text-[13.5px] font-semibold leading-tight text-text"> "Baseline thread"
          <div class="hidden truncate text-[12px] leading-4 text-text-secondary has-[[data-status]]:block has-[[data-testid=agent-state]]:block" data-testid="dock-window-status">
            <span> "2 members"
      <div class="flex shrink-0 items-center gap-0.5">
        <span class="inline-flex" type="button">
          <button class="gap-2 duration-150 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:pointer-events-none disabled:opacity-50 text-xs font-medium flex h-7 w-7 items-center justify-center rounded-md p-0 text-text-tertiary transition-colors hover:bg-surface-hover hover:text-text-secondary" type="button" aria-label="Collapse">
            <svg class="lucide lucide-minus lucide-icon" aria-hidden="true">
              <path>
        <span class="inline-flex" type="button">
          <button class="gap-2 duration-150 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:pointer-events-none disabled:opacity-50 text-xs font-medium flex h-7 w-7 items-center justify-center rounded-md p-0 text-text-tertiary transition-colors hover:bg-surface-hover hover:text-text-secondary" type="button" aria-label="Open in Home">
            <svg class="lucide lucide-external-link lucide-icon" aria-hidden="true">
              <path>
              <path>
              <path>
    <div class="min-h-0 flex-1">
      <div class="relative flex h-full flex-col gap-0 p-0">
        <div class="relative flex min-h-0 flex-1">
          <div class="flex min-w-0 flex-1 flex-col">
            <div class="relative flex overflow-hidden flex-col min-h-0 flex-1">
              <div class="pointer-events-none absolute z-10 transition-opacity duration-150 inset-x-0 top-0 h-4 opacity-0" data-testid="scroll-fade-start">
              <div class="min-h-0 min-w-0 flex-1 overflow-y-auto overflow-x-hidden px-4 pt-3 pb-dock-window-clearance" data-testid="message-scroll-container">
                <div class="flex items-center justify-center py-8 text-[13px] text-text-tertiary"> "Loading messages..."
              <div class="pointer-events-none absolute z-10 transition-opacity duration-150 inset-x-0 bottom-0 h-4 opacity-0" data-testid="scroll-fade-end">
            <div class="mt-auto">
              <div class="relative px-2 pb-2 pt-1" data-testid="compose-dropzone">
                <div class="flex flex-col overflow-hidden rounded-[18px] bg-elevated ring-1 ring-border-strong transition-[box-shadow] focus-within:shadow-composer-focus focus-within:ring-1 focus-within:ring-accent/40">
                  <div class="flex flex-col">
                    <div class="contents">
                      <div class="px-4 pb-1 pt-3.5">
                        <div class="relative w-full min-w-0 [--editor-bg:var(--color-elevated)]" data-testid="compose-field">
                          <div class="rich-editor flex min-w-0 flex-col gap-2.5">
                            <div class="min-w-0">
                              <div class="tiptap ProseMirror prose-thread min-w-0 outline-none max-h-[176px] min-h-[22px] overflow-y-auto text-[15px]! leading-[22px]!" role="textbox" data-testid="compose-editor" aria-label="Write a message" contenteditable="true">
                                <p class="is-empty is-editor-empty">
                                  <br class="ProseMirror-trailingBreak">
                          <div class="pointer-events-none absolute inset-x-0 bottom-0 select-none truncate text-text-secondary text-[15px] leading-[22px]">
                            <span class="sm:hidden"> "Write a message"
                            <span class="hidden sm:inline"> "Write a message... (@ people, # threads)"
                    <div class="flex items-center gap-0.5 px-2 pb-2 pt-1.5 flex-nowrap" data-testid="compose-controls-row">
                      <div class="contents">
                        <button class="flex h-[34px] w-[34px] shrink-0 items-center justify-center rounded-[10px] p-0 text-text-secondary transition-colors hover:bg-surface-hover hover:text-text disabled:opacity-40" type="button" data-testid="composer-plus" aria-label="Add attachment" title="Add attachment">
                          <svg class="lucide lucide-plus lucide-icon" aria-hidden="true">
                            <path>
                            <path>
                        <button class="flex h-[34px] w-[34px] shrink-0 items-center justify-center rounded-[10px] p-0 text-text-secondary transition-colors hover:bg-surface-hover hover:text-text disabled:opacity-40 aria-pressed:bg-surface-active aria-pressed:text-text" type="button" data-testid="compose-formatting" aria-label="Show formatting" title="Show formatting">
                          <svg class="lucide lucide-case-sensitive lucide-icon" aria-hidden="true">
                            <path>
                            <path>
                            <path>
                            <circle>
                        <button class="disabled:opacity-50 flex h-[34px] w-[34px] shrink-0 items-center justify-center rounded-[10px] p-0 text-text-secondary transition-colors hover:bg-surface-hover hover:text-text" type="button" data-testid="magic-wand" aria-label="Fix spelling & grammar" title="Fix spelling & grammar">
                          <svg class="lucide lucide-wand-sparkles lucide-wand-2 lucide-icon" aria-hidden="true">
                            <path>
                            <path>
                            <path>
                            <path>
                            <path>
                            <path>
                            <path>
                            <path>
                        <button class="outline-none disabled:opacity-50 flex h-[34px] w-[34px] shrink-0 items-center justify-center rounded-[10px] p-0 text-text-secondary transition-colors hover:bg-surface-hover hover:text-text" type="button" data-testid="compose-emoji" aria-label="Add emoji">
                          <svg class="lucide lucide-face-slightly-smiling lucide-smile lucide-icon" aria-hidden="true">
                            <path>
                            <path>
                            <path>
                            <circle>
                        <div class="ml-auto flex items-center gap-0.5">
                          <button class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-accent text-accent-foreground transition-[background-color,color,transform] hover:bg-accent-hover active:scale-95 disabled:cursor-not-allowed disabled:bg-surface-active disabled:text-text-tertiary disabled:active:scale-100" type="button" data-testid="compose-send" aria-label="Send message" disabled="">
                            <svg class="lucide lucide-arrow-up lucide-icon" aria-hidden="true">
                              <path>
                              <path>
                    <div class="hidden" data-testid="compose-hidden-attach">
                      <label class="inline-flex cursor-pointer items-center gap-1 rounded-sm border border-border bg-surface px-2 py-1 text-[11px] text-text hover:bg-surface-hover" data-testid="attachment-upload-button" aria-label="Attach" title="Attach">
                        <svg class="lucide lucide-paperclip lucide-icon" aria-hidden="true">
                          <path>
                        <span class="hidden sm:inline"> "Attach"
                        <input class="hidden" type="file" data-testid="attachment-upload-input">

=== model-selector ===
<span class="cursor-default rounded-full px-2 py-0.5 text-[11px] font-medium text-text-tertiary" data-testid="model-selector-label" title="Upgrade to change model"> "Auto"

=== login ===
<div class="flex min-h-screen items-center justify-center bg-overlay-heavy backdrop-blur-[20px] pt-[env(safe-area-inset-top)] pb-[env(safe-area-inset-bottom)] pl-[env(safe-area-inset-left)] pr-[env(safe-area-inset-right)]" data-testid="auth-page">
  <div class="w-full max-w-[380px] rounded-lg border border-border bg-elevated px-8 pt-9 pb-7" data-testid="auth-card">
    <div class="mb-7 text-center">
      <h1 class="font-display text-[24px] font-semibold tracking-[-0.02em] text-text"> "Liaison"
      <p class="mt-1 text-[13px] text-text-secondary"> "Sign in to your workspace"
    <form class="flex flex-col gap-4">
      <div class="flex flex-col gap-1.5">
        <label class="text-[12.5px] font-medium text-text-secondary"> "Email"
        <input class="w-full rounded-sm border bg-bg px-3 py-[9px] text-[13.5px] text-text outline-none transition-colors duration-150 placeholder:text-text-tertiary focus:border-accent-muted border-border" type="email" placeholder="you@company.com">
      <button class="inline-flex items-center justify-center gap-2 rounded-sm font-semibold transition-colors duration-150 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:pointer-events-none disabled:opacity-50 bg-accent text-accent-foreground border-none hover:bg-accent-hover py-[10px] px-4 text-[13.5px] w-full" type="submit"> "Continue with email"
    <div class="my-5 flex items-center gap-3">
      <div class="h-px flex-1 bg-border">
      <span class="text-[12px] text-text-tertiary"> "or"
      <div class="h-px flex-1 bg-border">
    <div class="flex flex-col gap-2">
    <div class="mt-4 flex flex-col items-center gap-2">
      <button class="text-[12.5px] text-accent-muted hover:text-accent transition-colors duration-150" type="button" data-testid="password-login-toggle"> "Sign in with a password"
      <a class="text-[12.5px] text-accent-muted hover:text-accent transition-colors duration-150 inactive"> "Create an account"
