        "agreements:agreements:read"
      ],
      "handler": "templatesListHandler",
      "readOnly": true,
      "params": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "proposal",
              "sow",
              "msa",
              "nda",
              "retainer",
              "tm",
              "dpa",
              "change_request",
              "other"
            ]
          },
          "include_archived": {
            "type": "boolean"
          }
        }
      }
    },
    "template_get": {
      "description": "Read one agreement template at its current or a given version.",
