<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The sidecar is a Bun standalone binary: JavaScriptCore JITs, so the
         hardened runtime needs both memory entitlements, and the agent session
         talks to the Liaison API and the model endpoint over the network.
         This file is the SIDECAR's. The outer app bundle keeps its own. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
