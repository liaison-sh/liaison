          }
        }
      }
    },
    "/orders": {
      "get": {
        "operationId": "listRecentOrders",
        "summary": "The latest sales orders across every customer, newest first, each with its company's name",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
