    "approval_route_read": {
      "description": "Who an agreement concerns, for routing its approvals.",
      "requiredScopes": [
        "agreements:agreements:read"
      ],
      "handler": "approvalRouteReadHandler",
      "readOnly": true,
      "agentVisible": false,
      "params": {
        "type": "object",
        "properties": {
          "entityType": {
            "type": "string"
          },
          "entityId": {
            "type": "string"
          }
        },
        "required": [
          "entityType",
          "entityId"
        ]
      }
    },
    "agreement_send": {
      "description": "Send a frozen agreement version for signature or acceptance to its signers, in order or all at once. Parks for a person's approval; nothing is sent if the version changed since agreement_prepare.",
      "searchKeywords": [
        "signer",
        "signature",
        "électronique",
        "envoyer",
        "contrat"
      ],
      "requiredScopes": [
        "agreements:agreements:write"
      ],
      "handler": "agreementSendHandler",
      "summarizer": "summarizeAgreementSend",
      "gated": true,
      "noAutoApprove": true,
      "approvalImpact": "external",
      "writesToTable": "app_agreements.agreements",
      "approvalCard": {
        "summary": "Send version {{params.version_id}} for signature"
      },
      "params": {
        "type": "object",
        "properties": {
          "version_id": {
            "type": "string",
            "description": "The version_id agreement_prepare returned."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "The fingerprint agreement_prepare returned for that version."
          },
          "mode": {
            "type": "string",
            "enum": [
              "sign",
              "accept"
            ]
          },
          "signers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "contact_id": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 40
          },
          "order": {
            "type": "string",
            "enum": [
              "sequential",
              "any"
            ]
          },
          "expires_in_days": {
            "type": "integer",
            "enum": [
              7,
              14,
              30
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 2000
          },
          "required_phrase": {
            "type": "string",
            "maxLength": 200
          },
          "sendGuard": {
            "type": "object",
            "additionalProperties": true,
            "description": "Set by the server; leave it out."
          },
          "guardKey": {
            "type": "string",
            "description": "Set by the server; leave it out."
          }
        },
        "required": [
          "version_id",
          "sha256",
          "signers"
        ]
      },
      "preflight": "agreementSendPreflightHandler",
      "pinnedParams": [
        "sendGuard",
        "guardKey"
      ],
      "approvalDedupeKeyParam": "guardKey"
    },
    "agreement_reminder_send": {
      "description": "Remind signers of an agreement waiting for signatures: each named signer whose link is still open gets a fresh link by mail, and the link mailed before stops working. Parks for a person's approval.",
      "searchKeywords": [
        "relance",
        "relancer",
        "remind",
        "reminder",
        "rappel",
        "signer",
        "contrat"
      ],
      "requiredScopes": [
        "agreements:agreements:write"
      ],
      "handler": "agreementReminderSendHandler",
      "summarizer": "summarizeAgreementReminderSend",
      "preflight": "agreementReminderSendPreflightHandler",
      "gated": true,
      "noAutoApprove": true,
      "approvalImpact": "external",
      "writesToTable": "app_agreements.agreements",
      "approvalCard": {
        "summary": "Remind the signers of an agreement"
      },
      "params": {
        "type": "object",
        "properties": {
          "client_action_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 40,
            "description": "The signers' links to remind, all of one agreement version (agreement_get lists them)."
          },
          "sendGuard": {
            "type": "object",
            "additionalProperties": true,
            "description": "Set by the server; leave it out."
          },
          "guardKey": {
            "type": "string",
            "description": "Set by the server; leave it out."
          }
        },
        "required": [
          "client_action_ids"
        ],
        "additionalProperties": false
      },
      "pinnedParams": [
        "sendGuard",
        "guardKey"
      ],
      "approvalDedupeKeyParam": "guardKey"
    },
    "agreement_new_link": {
      "description": "Give one signer a new signing link, at the same or a corrected address, in the same turn: after their link expired or was withdrawn, or after a decline made without the emailed code. Signatures already given stand. Parks for a person's approval.",
      "searchKeywords": [
        "lien",
        "link",
        "expired",
        "expiré",
        "adresse",
        "signer"
      ],
      "requiredScopes": [
        "agreements:agreements:write"
      ],
      "handler": "agreementNewLinkHandler",
      "summarizer": "summarizeAgreementNewLink",
      "preflight": "agreementNewLinkPreflightHandler",
      "gated": true,
      "noAutoApprove": true,
      "approvalImpact": "external",
      "writesToTable": "app_agreements.agreements",
      "approvalCard": {
        "summary": "A new signing link for client action {{params.client_action_id}}"
      },
      "params": {
        "type": "object",
        "properties": {
          "client_action_id": {
            "type": "string",
            "description": "The signer's link to replace, from agreement_get or agreement_send."
          },
          "email": {
            "type": "string",
            "description": "A corrected address; leave it out to use the one on file."
          },
          "expires_in_days": {
            "type": "integer",
            "enum": [
              7,
              14,
              30
            ]
          }
        },
        "required": [
          "client_action_id"
        ],
        "additionalProperties": false
      }
    },
    "agreement_void": {
      "description": "Void an agreement waiting for signatures: every open signing link is withdrawn at once and signatures already given stay. Parks for a person's approval.",
      "searchKeywords": [
        "annuler",
        "void",
        "withdraw",
        "retirer",
        "contrat",
        "contract"
      ],
      "requiredScopes": [
        "agreements:agreements:write"
      ],
      "handler": "agreementVoidHandler",
      "summarizer": "summarizeAgreementVoid",
      "gated": true,
      "noAutoApprove": true,
      "approvalImpact": "external",
      "writesToTable": "app_agreements.agreements",
      "approvalCard": {
        "summary": "Void agreement {{params.id}}"
      },
      "params": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "reason"
        ]
      },
      "preflight": "agreementVoidPreflightHandler"
    },
    "client_action_view_get": {
      "description": "What a person outside is shown for one agreement version, with its fingerprint (internal: the kernel's client action page).",
      "requiredScopes": [
        "agreements:internal"
      ],
      "handler": "clientActionViewGetHandler",
      "readOnly": true,
      "agentVisible": false,
      "params": {
        "type": "object",
        "properties": {
          "targetType": {
            "type": "string"
          },
          "targetId": {
            "type": "string"
          }
        },
        "required": [
          "targetType",
          "targetId"
        ]
      }
    }
  },
  "clientActionTargets": [
    {
      "type": "agreement_version",
      "kinds": [
        "sign",
        "accept"
      ],
      "viewTool": "client_action_view_get"
    }
  ],
  "events": {
    "subscribes": {
      "kernel/client_action:decided": "onClientActionDecidedHandler"
    },
    "emits": [
      "agreement:sent",
      "agreement:declined",
      "agreement:voided"
    ]
  },
  "jobs": {
    "decided-reconcile": {
      "handler": "decidedReconcileJobHandler",
      "atomic": false,
      "runsFor": {
        "rows": {
          "entity": "agreements",
          "where": {
            "status": {
              "in": [
                "sent",
                "partly_signed"
              ]
            }
          }
        }
      },
      "schedule": "*/10 * * * *",
      "timeoutMs": 120000
    }
  }
}
