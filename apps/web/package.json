{
  "name": "@liaison/web",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun scripts/build-app-frame.ts",
    "build:native": "vite build --mode native && bun scripts/build-app-frame.ts --native",
    "preview": "vite preview",
    "test": "vitest run src/App.test.tsx src/framework/ src/modules/ src/primitives/ src/lib/ src/ui/",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "bun run ../../scripts/with-test-lock.ts -- bun node_modules/.bin/playwright test",
    "test:e2e:ui": "bun node_modules/.bin/playwright test --ui"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@liaison/api-connector-core": "workspace:*",
    "@liaison/app-sdk": "workspace:*",
    "@liaison/host": "workspace:*",
    "@liaison/mailbox-crypto": "workspace:*",
    "@liaison/shared": "workspace:*",
    "@solid-primitives/i18n": "^2",
    "@solidjs/router": "^1.0.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-underline": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "cron-parser": "^5.10.1",
    "dompurify": "^3.4.17",
    "flexsearch": "0.8.212",
    "lucide-solid": "^1.49.0",
    "marked": "^18.0.14",
    "pino": "^10.3.1",
    "qrcode": "^1",
    "solid-js": "^1.9",
    "streaming-markdown": "^0.2.15",
    "tailwind-merge": "^3.7.0",
    "unicode-emoji-json": "0.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@liaison/test-helpers": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@solidjs/testing-library": "^0.8",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^6",
    "@types/bun": "^1",
    "@types/qrcode": "^1",
    "bullmq": "^6.3.10",
    "fake-indexeddb": "6.2.5",
    "fflate": "^0.8.3",
    "ioredis": "^6.0.0",
    "jsdom": "^29.0.1",
    "pdf-parse": "^1.1.4",
    "pdf-to-png-converter": "^4.0.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.2",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2",
    "vitest": "^4.1.2"
  }
}
