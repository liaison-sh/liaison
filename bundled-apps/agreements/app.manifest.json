    "template_save": {
      "description": "Save an agreement template as a new version; agreements made from earlier versions keep their text.",
      "searchKeywords": [
        "modèle",
        "template",
        "enregistrer",
        "save"
      ],
      "requiredScopes": [
        "agreements:templates:write"
      ],
      "handler": "templateSaveHandler",
      "writesToTable": "app_agreements.agreement_template_meta",
      "conditionalGate": true,
      "approvalImpact": "internal",
      "approvalCard": {
        "summary": "Save agreement template {{params.name}}"
      },
      "params": {
        "type": "object",
        "properties": {
          "template_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "proposal",
              "sow",
              "msa",
              "nda",
              "retainer",
              "tm",
              "dpa",
              "change_request",
              "other"
            ]
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "fr"
            ]
          },
          "fit_tag": {
            "type": "string",
            "enum": [
              "commercial",
              "guarantee",
              "real_estate",
              "family",
              "employment"
            ]
          },
          "body": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
