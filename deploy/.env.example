# SPDX-License-Identifier: FSL-1.1-ALv2
# Liaison self-hosted production env. Copy to `.env` next to docker-compose.yml.

# ----- Required secrets (generate with `openssl rand -hex 32`) -----
JWT_SECRET=
ENCRYPTION_KEY=
BYOK_ENCRYPTION_KEY=
MEILISEARCH_MASTER_KEY=
# MONITOR_TOKEN: bearer token the monitoring watchdog authenticates GET /diag
#   with. Required: the app refuses to boot in production without it.
MONITOR_TOKEN=

# ----- Update channel -----
# LIAISON_RELEASE_CHANNEL: `release` (the default) follows published releases,
#   each promoted from a nightly that has run on the maintainers' instances.
#   `nightly` follows the daily signed build of the newest main commit whose CI
#   is green, with no soak. Settings > System compares the running version
#   against the channel. It does not choose the image: set LIAISON_IMAGE to match
#   (`ghcr.io/liaison-sh/liaison:latest` or `:nightly`, or a pinned tag), or run
#   `./deploy/quickstart.sh --channel nightly|release`, which sets both.
#   Migrations only go forward: going from nightly back to release means staying
#   on your version until a release includes it. See docs/admin/upgrades.md.
# LIAISON_RELEASE_CHANNEL=release

# ----- Postgres credentials — TWO distinct roles -----
# POSTGRES_PASSWORD: the privileged bootstrap superuser (`liaison`). Used ONLY to
#   run database migrations (MIGRATION_DATABASE_URL) — schema/table/role/policy
#   DDL. Never used by the request-serving app.
POSTGRES_PASSWORD=
# LIAISON_APP_PASSWORD: the non-superuser runtime login role (`liaison_app`) the
#   app authenticates as. This role is subject to row-level security (no
#   BYPASSRLS, owns no tables), so per-org isolation is enforced for all runtime
#   traffic. Keep distinct from POSTGRES_PASSWORD.
LIAISON_APP_PASSWORD=
# LIAISON_REQUEST_PASSWORD: the request login (`liaison_request`). Request
#   transactions connect as it, and it can step into the row-level-security
#   role only: no SQL run from a request can reach a role that bypasses RLS,
#   owns a table or owns a policy. `liaison_app` keeps the privileged work. The
#   migration step gives the role LOGIN and this password. Empty runs requests
#   on `liaison_app` too (the older shape). Keep distinct from the others.
LIAISON_REQUEST_PASSWORD=
# LIAISON_READONLY_PASSWORD: the allow-list read-only role (`liaison_readonly`)
#   the database connector reads through. Required: the postgres cluster-init
#   hook that provisions that role refuses to run without it, which fails the
#   whole cluster init. Keep distinct from both passwords above.
LIAISON_READONLY_PASSWORD=

# ----- Host-facing URLs -----
BASE_URL=https://liaison.example.com
ALLOWED_ORIGINS=https://liaison.example.com
APP_PORT=3000
# Interface the app port is published on. Defaults to loopback so plain HTTP
# is never exposed off-host; a TLS-terminating reverse proxy on the same host
# connects to 127.0.0.1:${APP_PORT}. Set to 0.0.0.0 only if the proxy runs on
# a separate host on a trusted network (and add a host firewall rule).
APP_BIND=127.0.0.1
# Number of trusted reverse-proxy hops in front of the app. MUST be >= 1 when
# running behind Caddy/nginx, otherwise the rate limiter and login brute-force
# throttle see the proxy IP for every request and bucket all clients together.
# The proxy must send a sanitized X-Forwarded-For (strip any client-supplied
# value, append the real peer). Use 1 for a single proxy; raise it per extra
# trusted hop (e.g. a CDN in front of the proxy).
TRUSTED_PROXY_HOPS=1
# X-Forwarded-For is only read from a peer on loopback or a private range. If the
# proxy reaches the app from a public address, list its CIDRs here (comma-separated).
TRUSTED_PROXY_CIDRS=

# ----- Rate limits (requests per minute) -----
# Pre-auth, per client IP. One web-app page load is 26-40 API calls and a whole
# office usually shares a single egress address, so keep this generous: too low
# and a few colleagues navigating at once get 429 together.
RATE_LIMIT_DEFAULT=1200
# Post-auth, per acting user (bucketed user:<orgId>:<userId>). This is what
# actually contains a single runaway client, including an MCP connection token,
# so it cannot spend the shared per-IP budget. Unauthenticated requests are
# covered by RATE_LIMIT_DEFAULT only.
# One person's MCP client (a Claude Code loop, say) and their browser session
# share this single bucket, so a busy agent loop can 429 that person's own UI.
RATE_LIMIT_PER_USER=600

# ----- Email -----
# STRONGLY RECOMMENDED in production: passwordless sign-in emails a 6-digit code +
# magic link, so users cannot log in without a working mail transport. When unset,
# emails are logged to stdout (fine for dev, NOT for a real deployment).
SMTP_HOST=
# 587 upgrades with STARTTLS. For 465 (implicit TLS) also set SMTP_SECURE=true:
# without it a connection on 465 times out waiting for the greeting.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Alternative to SMTP: the Resend API (takes precedence over SMTP_* when set).
RESEND_API_KEY=
# Optional: a separate Resend key for system mail only. Empty = RESEND_API_KEY.
SYSTEM_RESEND_API_KEY=
# The sender of every mail Liaison sends. Use an address on a domain you own and
# authorize your SMTP or Resend provider for it (SPF, DKIM, DMARC records): mail
# from an unowned or unauthenticated domain is rejected or junked, and with
# passwordless sign-in that means nobody can sign in.
EMAIL_FROM=Liaison <noreply@liaison.example.com>
# Sender of Liaison's own mail to the team (sign-in links, invites, security
# codes). Empty = EMAIL_FROM. Set it when EMAIL_FROM is a customer-facing name.
SYSTEM_EMAIL_FROM=
# Quiet hours by default for people who never set work hours (20:00 to 08:00 on
# weekdays, all weekend): on or off. Off notifies them at any time.
# NOTIFICATIONS_DEFAULT_QUIET_HOURS=on
# Without SMTP, also write email BODIES (sign-in codes, invite and reset links)
# to the log, so a local trial can sign in. deploy/quickstart.sh turns it on.
# Leave it off on any instance other people sign in to.
LIAISON_CONSOLE_EMAIL_BODIES=

# ----- Mail encryption (personal mailboxes at rest) -----
# managed (transparent) or private (zero-access) for people who have not chosen.
# A default, not a lock. Empty: decided once on first use and kept (private if
# anyone had set up a private mailbox by then, transparent otherwise).
MAILBOX_ENCRYPTION_DEFAULT=
# false locks every personal mailbox to private (zero-access), whatever the
# default above says.
MAILBOX_ENCRYPTION_ALLOW_MANAGED=true

# ----- First-run setup token -----
# A fresh instance asks for a one-time setup token on the first registration, so
# a stranger cannot claim it before you. Leave empty: the app derives one and
# prints it in its log ("Liaison setup token: ..."; deploy/quickstart.sh shows
# it). Set a value here to choose your own.
LIAISON_SETUP_TOKEN=

# ----- App installs -----
# Multi-tenant instances only (demo mode, managed edition): installing, upgrading
# or removing an app changes what runs for every org on the instance, so only the
# instance operator's org may do it. Empty = the instance's first org (the one
# created at setup). A single-org self-host ignores this: any admin with the app
# admin scope manages apps. (Per-org app installs are the planned hosted design.)
LIAISON_OPERATOR_ORG_ID=

# ----- Database connector (db_query / db_read) -----
# Comma-separated hosts the connector may dial (`host` or `*.suffix`); empty
# allows any host except link-local/metadata addresses and this instance's own
# redis, search and object storage.
LIAISON_DATABASE_ALLOWED_HOSTS=
# The connector refuses a login that is a superuser or can assume a superuser or
# BYPASSRLS role. Set to true ONLY for a single-tenant database you own outright.
LIAISON_DB_ALLOW_PRIVILEGED_SESSION=

# ----- iOS push (optional; all four or none; see docs/notifications.md) -----
# Put the .p8 key under ./data/apns/ (./data is mounted at /var/lib/liaison).
# One key serves sandbox and production: each device token carries its environment.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=sh.liaison.mobile

# ----- Android push (optional; both or none; see docs/notifications.md) -----
# Put the Firebase service-account JSON under ./data/fcm/.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=

# ----- Browser push (optional; all three or none; see docs/notifications.md) -----
# Web Push (VAPID) keys for browser notifications. Empty = browser push off
# (one warning at the first send). Generate a pair once per deployment with
# `bunx web-push generate-vapid-keys`; the subject is a mailto: or https: contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ----- Google sign-in (optional) -----
# "Sign in with Google" LOGIN credentials. When both are set, a first-party
# Google login provider is auto-seeded for every org at boot — invited users
# only. Distinct from the Mail app's Gmail integration (configured in-app).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ----- Instance OAuth clients (optional; an org's own client wins) -----
# Clients this server provides to every org, so admins only consent. Each pair is
# both or none. Redirect URI for all of them: <BASE_URL>/api/connections/callback.
# `liaison guide google` and `liaison guide shopify` print the exact values.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_MARKETING_OAUTH_CLIENT_ID=
GOOGLE_MARKETING_OAUTH_CLIENT_SECRET=
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
# true only once Google verified the instance Google clients for restricted scopes.
GOOGLE_OAUTH_RESTRICTED_SCOPES_VERIFIED=false
# A Pub/Sub topic Gmail push publishes to for every org (optional; polling otherwise).
GMAIL_PUBSUB_TOPIC=
# That topic's push subscription (optional): its OIDC audience, the https URL it
# posts to, and the service account it signs as. Mail and Tickets verify push
# tokens with them when an org set none of its own.
GMAIL_PUSH_AUDIENCE=
GMAIL_PUSH_SERVICE_ACCOUNT=
# The Google Picker (Drive files chosen one by one): an API key and the project
# NUMBER of the Drive client's Google Cloud project.
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# ----- Object storage (SeaweedFS) -----
# Admin (administrative) credentials for the bundled SeaweedFS S3 gateway.
# Loaded into the gateway's own identity config at container start (so it
# never serves anonymously, not even for one request) and used by
# objectstore-init to create the bucket. Keep these SECRET and distinct from
# the OBJECT_STORAGE_* app credentials below. Pick long, random values (no
# format requirement from SeaweedFS itself; treat them like the other
# generated secrets in this file).
OBJECT_STORE_ADMIN_ACCESS_KEY=
OBJECT_STORE_ADMIN_SECRET_KEY=
# App S3 credentials — scoped (via the same identity config) to Read/Write/
# List/Tagging on OBJECT_STORAGE_BUCKET only: no bucket create/delete, no
# admin. When using an external S3 endpoint instead of the bundled
# SeaweedFS, set these to a key scoped to the bucket and ignore the
# OBJECT_STORE_ADMIN_* vars above (also set OBJECT_STORAGE_ENDPOINT below).
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=liaison
# Amazon S3 from an EC2 host with an instance role: OBJECT_STORAGE_AUTH=aws-default
# signs with the role (no static key; the two keys above are then ignored), with
# OBJECT_STORAGE_ENDPOINT=https://s3.<region>.amazonaws.com, OBJECT_STORAGE_REGION
# and OBJECT_STORAGE_FORCE_PATH_STYLE=false.
# OBJECT_STORAGE_AUTH=keys
# External S3-compatible store (Amazon S3, Cloudflare R2) instead of the bundled one:
# OBJECT_STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# OBJECT_STORAGE_REGION=auto
# OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Browsers reach the store directly (presigned URLs; needs the bucket's CORS rule):
# OBJECT_STORAGE_BROWSER_DIRECT=true
# OBJECT_STORAGE_PUBLIC_URL=

# ----- AI provider keys (platform fallback for non-BYOK orgs) -----
# When an org has NOT brought its own provider key (BYOK), the agent
# credit-meter falls back to these platform keys. At least ONE must be set for
# any org that does not BYOK its own key, or that org's first agent turn hard-
# fails with "No API key available for provider…". A BYOK-only deployment
# (every org supplies its own key) may legitimately leave all of these unset.
LIAISON_ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Required for media-analysis (Gemini) — image/document understanding falls
# back to this key when the org has not supplied its own Google key.
GOOGLE_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# OpenRouter upstream hosts no request is sent to (comma-separated, as OpenRouter
# names them). Default OpenInference; set it empty to allow every host.
# LIAISON_OPENROUTER_IGNORE_HOSTS=OpenInference
# Web search for the agents (Exa). Optional; an org may bring its own key.
EXA_API_KEY=

# ----- Control plane (optional; both must be set or both unset) -----
# They do not make the server managed: that is LIAISON_EDITION=managed. Set
# without LIAISON_EDITION, the server runs self-hosted and logs a warning
# saying what to set.
CONTROL_PLANE_URL=
CONTROL_PLANE_API_KEY=

# ----- Sharing with the Liaison team (optional; docs/self-hosting/liaison-team.md) -----
# Unset: the Liaison team's endpoint. Empty: sharing is not available on this server.
# Nothing is sent until an admin turns sharing on (Settings > System).
# LIAISON_TEAM_ENDPOINT=
# The Liaison team's own demo server only; leave off.
# LIAISON_TEAM_FORWARD_DEMO_LEADS=false

# ----- Runtime app installs (.liaisonapp) -----
# Signed packages are required by default. The trusted publisher is ONE cosign
# certificate-identity regex, matched against the whole identity (anchored ^(?:...)$);
# a match-everything wildcard is refused. Join several identities with |.
# LIAISON_REQUIRE_APP_SIGNATURE=true
# LIAISON_TRUSTED_APP_PUBLISHERS=https://github\.com/your-org/your-repo/\.github/workflows/release\.yml@refs/heads/main

# ----- Device Flow (MCP) — required: comma-separated allowed client IDs -----
# Required functional value (compose uses ${DEVICE_FLOW_CLIENTS:?…}); it is the
# comma-separated list of MCP client IDs allowed to use device-flow auth. This
# is NOT boilerplate to delete — keep `mcp-cli` unless you know otherwise.
# The desktop app (`liaison-desktop`) is admitted whenever this is non-empty.
DEVICE_FLOW_CLIENTS=mcp-cli

# ----- Apps reaching private services (optional) -----
# Comma-separated `host` or `host:port` (exact names) that installed apps may reach
# over plain HTTP on a private or loopback address, for a service on this
# deployment's own network. The app's manifest must still list the host; link-local
# and metadata addresses are always refused. Empty = apps reach public HTTPS only.
LIAISON_APP_PRIVATE_HOSTS=

# ----- Virus scanning of inbound attachments (optional) -----
# A clamd daemon reachable over TCP (`host` or `host:port`, port 3310 by default).
# Each inbound mail and ticket attachment is scanned before it is stored; an
# infected one is replaced on the message by a short notice, its bytes kept under
# orgs/<org>/quarantine/ in object storage, and admins get a security alert. A
# scan that cannot complete stores the attachment as before and logs an error.
# Empty = no scanning.
CLAMAV_HOST=

# ----- Legal-retention archive on organization delete -----
# `liaison org delete` first writes the records the law says to keep (issued
# invoices and credit notes, their PDFs, the audit log) into an archive encrypted
# with age to this recipient (`age1...`, from `age-keygen`). The server holds only
# this public key; keep the identity that reads the archive off the server.
# Empty = a deletion refuses unless --no-legal-archive waives the archive.
LEGAL_ARCHIVE_RECIPIENT=
# Years an archive is kept before a daily job deletes it (default 10).
LEGAL_ARCHIVE_RETENTION_YEARS=10
