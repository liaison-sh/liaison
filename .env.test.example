# Test environment for scripts/test-run.ts and `bun run test:*`.
# Copy to .env.test (gitignored) and fill in the two secrets:
#   cp .env.test.example .env.test
#   JWT_SECRET:     openssl rand -hex 32
#   ENCRYPTION_KEY: openssl rand -hex 32   (exactly 64 hex characters)
# The services are the local test substrate from docker-compose.yml
# (`bun run infra:up`). A namespaced run (every run through scripts/test-run.ts)
# replaces DATABASE_URL with its own database and MEILISEARCH_API_KEY with the
# substrate's key, so a value your own .env carries cannot leak into tests.
NODE_ENV=test
DATABASE_URL=postgres://liaison:liaison@localhost:5432/liaison_test
REDIS_URL=redis://localhost:6379
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=dev-master-key
S3_ENDPOINT=http://localhost:9000
BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=
ENCRYPTION_KEY=
# Optional: a real Exa key for the few live web-search scenarios that opt in.
EXA_API_KEY=
# The suite is written against zero-access (private) mailboxes; tests of the
# transparent (server-managed) mode pass the mode explicitly. Unset, `auto`
# would depend on what earlier tests left in the database.
MAILBOX_ENCRYPTION_DEFAULT=private
