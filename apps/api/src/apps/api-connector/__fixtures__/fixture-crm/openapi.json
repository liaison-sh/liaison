          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/companies/{id}/orders": {
      "get": {
        "operationId": "listOrders",
        "summary": "A company's sales orders, newest first",
        "parameters": [
          {
            "$ref": "#/components/parameters/CompanyId"
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Only orders on or after this date"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["pending", "shipped", "delivered", "cancelled"]
            },
            "description": "Only orders in this status"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
